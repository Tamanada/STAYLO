{
  "rewrites": [
    { "source": "/ship.html",       "destination": "/ship-core/ship.html" },
    { "source": "/SHIP_LOGO.png",   "destination": "/ship-core/SHIP_LOGO.png" },
    { "source": "/SHIP_LOGO.webp",  "destination": "/ship-core/SHIP_LOGO.webp" },
    { "source": "/ShipBanner.png",  "destination": "/ship-core/ShipBanner.png" },
    { "source": "/ShipBanner.webp", "destination": "/ship-core/ShipBanner.webp" },
    { "source": "/(.*)",            "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
